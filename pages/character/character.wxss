.container {
  padding: 0;
  background-color: #F5F5DC;
}

.character-header {
  display: flex;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #8B0000 0%, #5C0000 100%);
  color: #fff;
}

.char-avatar-large {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.char-avatar-large.刘备 { background-color: #52C41A; }
.char-avatar-large.曹操 { background-color: #1890FF; }
.char-avatar-large.孙吴 { background-color: #722ED1; }
.char-avatar-large.董卓 { background-color: #F5222D; }
.char-avatar-large.袁绍 { background-color: #FA8C16; }
.char-avatar-large.吕布 { background-color: #EB5757; }
.char-avatar-large.诸葛亮 { background-color: #52C41A; }
.char-avatar-large.孙权 { background-color: #722ED1; }
.char-avatar-large.周瑜 { background-color: #722ED1; }
.char-avatar-large.孙坚 { background-color: #722ED1; }
.char-avatar-large.赵云 { background-color: #52C41A; }
.char-avatar-large.关羽 { background-color: #52C41A; }
.char-avatar-large.张飞 { background-color: #52C41A; }

.char-basic {
  flex: 1;
}

.char-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.char-name {
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
}

.char-courtesy {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.char-faction-row {
  margin-bottom: 16rpx;
}

.faction-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.char-birthplace {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.section {
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #D4AF37;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-text {
  font-size: 28rpx;
  line-height: 2;
  color: #333;
}

.chapters-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chapter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.chapter-item:last-child {
  border-bottom: none;
}

.chapter-info {
  flex: 1;
}

.chapter-num {
  font-size: 24rpx;
  color: #8B0000;
  margin-right: 16rpx;
}

.chapter-title {
  font-size: 26rpx;
  color: #333;
}

.mini-map {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.map {
  width: 100%;
  height: 400rpx;
}
