.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #8B0000 0%, #5C0000 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #D4AF37;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-btn text {
  font-size: 24rpx;
  color: #2C2C2C;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #D4AF37;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chapter-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chapter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.chapter-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B0000;
}

.chapter-tags {
  display: flex;
  gap: 12rpx;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.chapter-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.chapter-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.character-avatars {
  display: flex;
  gap: 16rpx;
}

.char-name {
  font-size: 22rpx;
  color: #8B0000;
  background-color: #FFF5F5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
