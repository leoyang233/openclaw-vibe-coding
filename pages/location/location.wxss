.container {
  padding: 30rpx;
  background-color: #F5F5DC;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.type-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.filter-pill {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #fff;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-pill.active {
  background-color: #8B0000;
  color: #fff;
}

.locations-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.location-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.location-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #FFF5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.location-info {
  flex: 1;
}

.location-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.location-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.location-ancient {
  font-size: 24rpx;
  color: #999;
}

.location-type {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.tag-都城 { background-color: #FFF0F0; color: #F5222D; }
.tag-城池 { background-color: #E6F3FF; color: #1890FF; }
.tag-关隘 { background-color: #FFF7E6; color: #FA8C16; }
.tag-战场 { background-color: #F4F0FF; color: #722ED1; }
.tag-隐居地 { background-color: #E6FFE6; color: #52C41A; }

.location-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}
