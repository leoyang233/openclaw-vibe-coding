page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background-color: #F5F5DC;
  color: #2C2C2C;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #D4AF37;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2C2C2C;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-wei { background-color: #E6F3FF; color: #1890FF; }
.tag-shu { background-color: #E6FFE6; color: #52C41A; }
.tag-wu { background-color: #FFF0F0; color: #FF4D4F; }
.tag-neutral { background-color: #F5F5F5; color: #666; }

.btn-primary {
  background-color: #8B0000;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

.btn-secondary {
  background-color: #fff;
  color: #8B0000;
  border: 2rpx solid #8B0000;
  border-radius: 40rpx;
  padding: 18rpx 60rpx;
  font-size: 28rpx;
}
